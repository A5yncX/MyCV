---
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildResume, getProfileList } from "../lib/resume.js";

const profiles = getProfileList();
const resume = buildResume(profiles[0].slug);
---

<BaseLayout
  title="CV · 简历目录"
  description="选择查看不同方向的简历"
  theme={resume.theme}
>
  <main class="index-page">
    <h1>简历目录</h1>
    <p class="index-desc">同一份经历数据，按方向灵活拼接展示。</p>
    <ul class="profile-list">
      {
        profiles.map((profile) => (
          <li>
            <a href={`/${profile.slug}/`}>{profile.label}</a>
            <span>{profile.pageTitle}</span>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>

<style>
  .index-page {
    width: min(720px, calc(100% - 2rem));
    margin: 3rem auto;
    padding: 2rem;
    background: white;
    border-radius: 0.5rem;
    box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1);
  }

  .index-page h1 {
    margin: 0 0 0.5rem;
    font-size: 1.5rem;
  }

  .index-desc {
    margin: 0 0 1.5rem;
    color: #52525b;
  }

  .profile-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .profile-list li {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.875rem 1rem;
    border: 1px solid #e4e4e7;
    border-radius: 0.375rem;
  }

  .profile-list a {
    font-weight: 700;
    color: #dc2626;
    text-decoration: underline;
  }

  .profile-list span {
    font-size: 0.875rem;
    color: #71717a;
  }
</style>
